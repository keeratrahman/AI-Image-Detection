.DS_Store
._*
__pycache__/
*.pyc
.venv/
*.pt
runs_*/
# final runs: keep metrics.json and config.yaml (like runs/), ignore checkpoints, preds, wandb
!runs_final/
runs_final/*/*
!runs_final/*/metrics.json
!runs_final/*/config.yaml
runs/*/*
!runs/*/metrics.json
!runs/*/config.yaml
!runs_pace/
runs_pace/*/*
!runs_pace/*/metrics.json
!runs_pace/*/config.yaml
wandb/
genimage_dl/
genimage_pool/
genimage_subset/
*.zip
*.tar
logs/
results/figures/*.npz
updated_data/
features/
